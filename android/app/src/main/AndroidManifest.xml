<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 카카오 로그인 App Link: 카카오가 이 https 주소로 redirect 하면
                 브라우저 대신 이 앱이 열려 KakaoDeepLinkHandler 가 code 를 받는다.
                 autoVerify 는 https://cheddar-care.com/.well-known/assetlinks.json 로 검증됨. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="cheddar-care.com"
                    android:pathPrefix="/oauth/kakao/app-callback"
                />
            </intent-filter>

            <!-- 커스텀 스킴 폴백. 위 App Link 검증이 실패하면 카카오 redirect 가
                 앱이 아니라 브라우저에서 열리는데, 그때 뜨는 환승 페이지
                 (public/oauth/kakao/app-callback)가 이 스킴으로 앱을 깨운다.
                 iOS 가 쓰던 경로를 안드로이드도 함께 쓴다 — assetlinks 검증
                 상태와 무관하게 동작하므로 로그인이 막히지 않는다. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="cheddarcare" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
