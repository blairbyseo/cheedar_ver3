    "cap:sync:ios": "vite build --mode app && cap sync ios",
    "cap:open:ios": "cap open ios",
    "ios": "vite build --mode app && cap sync ios && cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
